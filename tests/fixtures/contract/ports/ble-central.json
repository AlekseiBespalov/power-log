{
  "os": {
    "radio": ["state"],
    "remembered": ["bike"],
    "restored": ["bike", "state"],
    "discovered": ["bike", "name", "rssi", "services", "manufacturerData", "atMonoUs"],
    "scanFailed": ["code"],
    "chooserCancelled": [],
    "noActivation": [],
    "connected": ["bike"],
    "connectFailed": ["bike", "platform"],
    "disconnected": ["bike", "systemReconnecting", "platform"],
    "database": ["bike", "services", "maxWriteBytes", "notifyFails"],
    "servicesModified": ["bike"],
    "notify": ["bytes", "atMonoUs"],
    "notifyError": ["platform"],
    "writeBusy": [],
    "writeReady": [],
    "writeError": ["platform"]
  },
  "osCalls": ["connect", "cancel"],
  "profiles": {
    "uart": {"service": "6e400001-b5a3-f393-e0a9-e50e24dcca9e", "notify": "6e400003-b5a3-f393-e0a9-e50e24dcca9e", "write": "6e400002-b5a3-f393-e0a9-e50e24dcca9e", "namePrefixes": []}
  },
  "scenarios": [
    {
      "name": "the iPhone's radio is unknown until the central reports its state",
      "platforms": ["ios"],
      "steps": [
        {"call": "radio", "returns": "unknown"},
        {"call": "prepare"},
        {"call": "radio", "returns": "unknown"},
        {"os": "radio", "args": {"state": "poweredOn"}},
        {"expect": "radioChanged", "args": {"state": "poweredOn"}},
        {"call": "radio", "returns": "poweredOn"},
        {"call": "prepare"},
        {"expectNone": true}
      ]
    },
    {
      "name": "the radio is known before prepare on Android and web",
      "platforms": ["android", "web"],
      "steps": [
        {"call": "radio", "returns": "poweredOn"},
        {"call": "prepare"},
        {"expectNone": true}
      ]
    },
    {
      "name": "a search reports each result, stamped in the callback",
      "platforms": ["ios", "android"],
      "steps": [
        {"call": "prepare"},
        {"os": "radio", "args": {"state": "poweredOn"}},
        {"expect": "radioChanged", "args": {"state": "poweredOn"}},
        {"call": "startSearch", "args": {"profiles": ["uart"], "inventory": false}},
        {"os": "discovered", "args": {"bike": "D1", "name": "X6", "rssi": -60, "services": ["6e400001-b5a3-f393-e0a9-e50e24dcca9e"], "manufacturerData": "UEw=", "atMonoUs": 1000}},
        {"expect": "advertised", "args": {"advertisement": {"bike": "D1", "name": "X6", "rssi": -60, "services": ["6e400001-b5a3-f393-e0a9-e50e24dcca9e"], "manufacturerData": null, "at": {"monoUs": 1000}}}},
        {"os": "discovered", "args": {"bike": "D2", "name": null, "rssi": -70, "services": ["6e400001-b5a3-f393-e0a9-e50e24dcca9e"], "atMonoUs": 2000}},
        {"expect": "advertised", "args": {"advertisement": {"bike": "D2", "name": null, "rssi": -70, "at": {"monoUs": 2000}}}},
        {"call": "stopSearch"},
        {"os": "discovered", "args": {"bike": "D3", "name": "X12", "rssi": -50, "services": ["6e400001-b5a3-f393-e0a9-e50e24dcca9e"], "atMonoUs": 3000}},
        {"expectNone": true}
      ]
    },
