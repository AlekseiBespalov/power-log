{
  "schemaVersion": 2,
  "maximumFileBytes": 4194304,
  "files": ["events.previous.jsonl", "events.jsonl"],
  "events": [
    "engine_started",
    "connect_requested",
    "connection_attempt",
    "link_connected",
    "identity_verified",
    "transport_stage",
    "transport_error",
    "disconnect_requested",
    "disconnected",
    "connection_failed",
    "reconnect_scheduled",
    "session_stopped",
    "bluetooth_state",
    "telemetry_summary",
    "telemetry_gap",
    "request_resent",
    "background_changed",
    "recording_error",
    "restored",
    "resumed"
  ],
  "reasons": [
    "manual_disconnect",
    "connection_deadline",
    "response_timeout",
    "expired_reply",
    "write_ready_timeout",
    "write_failed",
    "link_disconnected",
    "connection_failed",
    "notification_setup",
    "notification_error",
    "service_discovery",
    "characteristic_discovery",
    "services_invalidated",
    "identity_rejected",
    "telemetry_rejected",
    "write_capacity",
    "retry_limit",
    "cancellation_deadline",
    "bluetooth_unavailable",
    "platform_error",
    "unexpected_connection",
    "pending_reconnect",
    "restoration_cleanup",
    "storage_failure",
    "app_terminating",
    "planned_reconnect"
  ],
  "numbers": [
    "requestedHz",
    "sampleCount",
    "connectionAttempts",
    "reconnects",
    "requestTimeouts",
    "decoderDiscardedBytes",
    "lastSampleAgeSeconds",
    "gapSeconds",
    "linkSamples",
    "connectionSeconds",
    "sampleAgeSeconds",
    "cancellationCallbackSeconds",
    "connectionSecondsAtCancel",
    "sampleAgeSecondsAtCancel",
    "requestAgeSeconds",
    "writeBlockedSeconds",
    "retryAttempt",
    "retryDelaySeconds",
    "errorCode",
    "recentSampleHz",
    "latencyMeanMs",
    "latencyMaxMs",
    "notificationErrors",
    "pendingBytes",
    "queueDelaySeconds",
    "storageWriteMs",
    "connectionGeneration",
    "cpuSeconds",
    "thermalState",
    "thermalStatus"
  ],
  "booleans": ["background", "systemReconnect", "recordingFailed", "interactive", "powerSave", "deviceIdle"],
  "strings": {
    "initiator": ["app", "peer_or_system"],
    "request": ["identity", "telemetry"],
    "manager": ["central"],
    "status": ["idle", "scanning", "connecting", "connected", "reconnecting", "error"],
    "bluetoothState": ["unknown", "resetting", "unsupported", "unauthorized", "poweredOff", "poweredOn"]
  },
  "errorDomains": [
    "CBErrorDomain",
    "CBATTErrorDomain",
    "NSCocoaErrorDomain",
    "NSPOSIXErrorDomain",
    "NSOSStatusErrorDomain",
    "AndroidGattStatus",
    "AndroidBluetoothStatus"
  ],
  "unknownErrorDomain": "OtherErrorDomain",
  "v2": {
    "levels": ["info", "warning", "error"],
    "maximumLineBytes": 4096,
    "events": {
      "launch": {
        "reason": "enum:LaunchReason",
        "outcome": ["ready", "refused"],
        "refusal": "enum:RefusalDetail",
        "launchMs": "integer",
        "appVersion": "text",
        "appBuild": "text",
        "pragmas": "object"
      },
      "foreground": {
        "foreground": "flag"
      },
      "searchStarted": {
        "inventory": "flag"
      },
      "searchEnded": {
        "reason": ["windowEnded", "stopped", "chooserCancelled", "searchFailed"],
        "found": "integer",
        "platform": "platform"
      },
      "connectAttempt": {
        "attempt": "integer",
        "adopt": "flag",
        "known": "flag"
      },
      "linkUp": {
        "attempt": "integer",
        "elapsedMs": "integer"
      },
      "linkDown": {
        "initiator": ["app", "peerOrSystem"],
        "reason": [
          "replyTimeout",
          "attemptTimeout",
          "writeTimeout",
          "rider",
          "rideEnded",
          "radio",
          "servicesInvalidated",
          "plannedReconnect",
          "gattSetup",
          "rejected",
          "writeCapacity",
          "pendingReconnect"
        ],
        "systemReconnecting": "flag",
        "linkMs": "integer",
        "sampleAgeMs": "integer",
        "platform": "platform",
        "notifications": "integer",
        "discardedBytes": "integer",
        "pendingBytes": "integer",
        "unknownFrames": "integer",
        "unknownCommand": "integer",
        "droppedReplies": "integer"
      },
      "linkFailed": {
        "attempt": "integer",
        "platform": "platform"
      },
      "ready": {
        "outcome": "enum:GattResult",
        "maxWriteBytes": "integer",
        "platform": "platform"
      },
      "identity": {
        "outcome": ["verified", "rejected"],
        "rejection": "enum:ControllerRequest"
      },
      "telemetryGap": {
        "gapMs": "integer"
      },
      "location": {
        "state": "enum:LocationProviderState"
      },
      "cancellationDeadline": {
        "released": "flag",
        "platform": "platform"
      },
      "requestResent": {},
      "replyTimeout": {
        "request": "enum:ControllerRequest",
        "held": "flag",
        "waitedMs": "integer",
        "notifications": "integer",
        "discardedBytes": "integer",
        "pendingBytes": "integer",
        "unknownFrames": "integer",
        "unknownCommand": "integer",
        "droppedReplies": "integer"
      },
      "writeFailed": {
        "result": ["accepted", "blocked", "tooLong", "notConnected", "failed"],
        "platform": "platform"
      },
      "reconnectScheduled": {
        "attempt": "integer",
        "delayMs": "integer",
        "reason": [
          "replyTimeout",
          "attemptTimeout",
          "writeTimeout",
          "rider",
          "rideEnded",
          "radio",
          "servicesInvalidated",
          "plannedReconnect",
          "gattSetup",
          "rejected",
          "writeCapacity",
          "pendingReconnect",
          "peerOrSystem",
          "linkFailed"
        ]
      },
      "terminate": {
        "finished": "flag"
      },
      "reconnectGaveUp": {
        "attempts": "integer",
        "code": "enum:FailureCode"
      },
      "rateChanged": {
        "hz": [1, 2, 4, 8],
        "background": "flag"
      },
      "radio": {
        "state": "enum:RadioState"
      },
      "bikeForgotten": {
        "reason": ["rider", "gaveUp", "radio", "rideEnded"]
      },
      "captureSummary": {
        "windowMs": "integer",
        "requestedHz": "integer",
        "receivedHz": "decimal",
        "admitted": "integer",
        "dropped": "integer",
        "committed": "integer",
        "busy": "integer",
        "inboxHigh": "integer",
        "commitMaxMs": "integer",
        "background": "flag",
        "recording": "flag",
        "replyMeanMs": "integer",
        "replyMaxMs": "integer",
        "notificationErrors": "integer",
        "discardedBytes": "integer",
        "timerLateMs": "integer",
        "fixesDropped": "object",
        "processCpuMs": "integer",
        "footprintBytes": "integer",
        "thermal": "enum:ThermalLevel",
        "powerSave": "flag"
      },
      "storageFailed": {
        "kind": "enum:StorageErrorKind",
        "stage": ["capture", "command", "launch", "maintenance", "health", "read", "cache"],
        "platform": "platform"
      },
      "ridePhase": {
        "phase": "enum:RidePhase|discarded",
        "issuer": "enum:CommandIssuer",
        "code": "enum:FailureCode"
      },
      "syncBeep": {
        "action": "enum:CueAction|test",
        "outcome": ["played", "failed", "cancelled"],
        "lateMs": "integer",
        "route": "enum:AudioRoute",
        "error": "enum:PortErrorKind",
        "platform": "platform"
      },
      "healthOutcome": {
        "outcome": "enum:HealthOutcome",
        "reason": "enum:HealthReason",
        "provider": "enum:HealthProviderKind"
      },
      "failure": {
        "source": [
          "health",
          "workoutSession",
          "keepAlive",
          "rideCard",
          "permissions",
          "files",
          "watchLink",
          "watch",
          "exports"
        ],
        "error": "enum:PortErrorKind|enum:FailureCode",
        "platform": "platform"
      },
      "unexpected": {
        "component": "text",
        "exception": "text",
        "frames": "texts",
        "image": "text",
        "load": "text"
      },
      "crash": {
        "exception": "text",
        "image": "text",
        "load": "text",
        "frames": "texts",
        "thread": "text"
      },
      "exit": {
        "reason": "text",
        "status": "integer",
        "importance": "integer",
        "atUtcUs": "integer"
      }
    }
  }
}
