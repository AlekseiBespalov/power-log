expression -l Swift --timeout 120000000 --all-threads true -- try { () -> Void in let root = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0].appendingPathComponent("PowerLog"); let store = try PowerLogStore.shared(databaseURL: root.appendingPathComponent("power-log.sqlite3")); let began = ProcessInfo.processInfo.systemUptime; let snapshot = try WorkoutDistanceStore(store: store).snapshot(id: "<printed-ride-id>"); let buildMs = (ProcessInfo.processInfo.systemUptime - began) * 1000; let data = try WorkoutCoding.encoder().encode(snapshot.sources); _ = try JSONSerialization.jsonObject(with: data); print("distanceBuildMs", buildMs, "maximumPointID", snapshot.maximumPointID, "sources", String(data: data, encoding: .utf8)!); }()
